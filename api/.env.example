# Copie para api/.env e preencha (as chaves do projeto compartilhado são passadas em privado).
PORT=3333
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só a API usa; nunca vai para o front nem para o Git.
SUPABASE_SECRET_KEY=sb_secret_...
TMDB_READ_TOKEN=eyJ...
# Origem do front quando não está atrás do proxy do Vite (ex.: publicação).
CORS_ORIGIN=
# Validade do cache do catálogo no banco, em horas; 0 desliga.
CACHE_CATALOGO_HORAS=24
