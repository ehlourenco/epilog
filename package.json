{
  "name": "epilog",
  "private": true,
  "description": "EpiLog — diário e catálogo de séries de TV (OTES-02, UDESC)",
  "workspaces": [
    "api"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
